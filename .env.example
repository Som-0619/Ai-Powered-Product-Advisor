# ============================================================
# Product Advisor Environment Configuration
# ============================================================

# Environment: "local" or "aws"
ENVIRONMENT=local
PROJECT_NAME="Product Advisor"
DEBUG=true
LOG_LEVEL=INFO

# API Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL locally, Aurora on AWS)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=product_advisor
POSTGRES_USER=advisor_user
POSTGRES_PASSWORD=advisor_password
# For local host access outside Docker: use localhost instead of postgres
LOCAL_POSTGRES_URL=postgresql+asyncpg://advisor_user:advisor_password@localhost:5432/product_advisor
DATABASE_URL=postgresql+asyncpg://advisor_user:advisor_password@postgres:5432/product_advisor

# OpenSearch (OpenSearch locally, OpenSearch Serverless on AWS)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
LOCAL_OPENSEARCH_HOST=localhost

# Cache (Redis locally, ElastiCache on AWS)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
LOCAL_REDIS_HOST=localhost

# Storage (MinIO locally, Amazon S3 on AWS)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=product-advisor-data
STORAGE_REGION=us-east-1
STORAGE_SECURE=false
LOCAL_STORAGE_ENDPOINT=http://localhost:9000

# Queue (Redis local queue locally, Amazon SQS on AWS)
QUEUE_PROVIDER=redis

# Model Runtime (Ollama locally)
OLLAMA_BASE_URL=http://ollama:11434
LOCAL_OLLAMA_BASE_URL=http://localhost:11434

# Models configuration
FAST_MODEL=qwen:4b
REASONING_MODEL=qwen2.5:7b
VISION_MODEL=moondream:1.8b
EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3

